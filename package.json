{
  "name": "agent-rack-silka",
  "version": "0.1.0",
  "private": true,
  "description": "Claude manda, Codex / OpenCode / Cursor trabajan: agent-rack listo para Windows, macOS y Linux con setup de un comando.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "silka": "src/silka/cli.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test --import ./test/setup-env.mjs \"test/*.test.mjs\"",
    "silka": "node src/silka/cli.mjs",
    "spec:validate": "openspec validate --specs --strict",
    "e2e:worktree": "node scripts/e2e-worktree-session.mjs",
    "e2e:contencion": "node scripts/e2e-contencion.mjs",
    "e2e:ciclo": "node scripts/e2e-task-cycle.mjs",
    "evals": "node evals/run.mjs",
    "evals:smoke": "node evals/run.mjs --smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abraham2106/agent-rack-silka.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agent-rack": "0.12.1",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.1.1"
  }
}
